{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAdOps Creative Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "executive_summary", "guidance", "suggestions"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "executive_summary": { "type": "string", "minLength": 2 },
    "guidance": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "status", "item", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["casting", "copy", "scene", "culture_policy", "production", "platform"] },
          "status": { "type": "string", "enum": ["required", "recommended", "confirm"] },
          "item": { "type": "string", "minLength": 2 },
          "reason": { "type": "string", "minLength": 2 }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "platform", "market", "language", "production_method", "asset_reference", "copy", "modification_notes", "deliverable", "format", "quantity", "must_keep", "prohibited", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 2 },
          "platform": { "type": "string", "minLength": 2 },
          "market": { "type": "string", "minLength": 1 },
          "language": { "type": "string" },
          "production_method": { "type": "string", "minLength": 1 },
          "asset_reference": { "type": "string" },
          "copy": { "type": "string" },
          "modification_notes": { "type": "string", "minLength": 2 },
          "deliverable": { "type": "string", "minLength": 1 },
          "format": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 20 },
          "must_keep": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 8 },
          "prohibited": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 8 },
          "rationale": { "type": "string", "minLength": 2 }
        }
      }
    }
  }
}
