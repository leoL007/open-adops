{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAdOps Creative Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "executive_summary", "guidance", "suggestions"],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0" },
    "executive_summary": { "type": "string", "minLength": 2 },
    "guidance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "status", "item", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["casting", "copy", "scene", "culture_policy", "production", "platform"] },
          "status": { "type": "string", "enum": ["required", "recommended", "confirm"] },
          "item": { "type": "string", "minLength": 2 },
          "reason": { "type": "string", "minLength": 2 }
        }
      }
    },
    "suggestions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "asset_reference", "copy", "modification_notes", "format", "quantity", "rationale"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "asset_reference": { "type": "string", "const": "" },
          "copy": { "type": "string" },
          "modification_notes": { "type": "string", "minLength": 2 },
          "format": { "type": "string" },
          "quantity": { "type": ["integer", "null"], "minimum": 1, "maximum": 20 },
          "rationale": { "type": "string", "minLength": 2 }
        }
      }
    }
  }
}
